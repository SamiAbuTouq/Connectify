rules_version = '2';

// ---------------------------------------------------------------------------
// Connectify — Firestore Security Rules
//
// Collections covered
// -------------------
//  users/{uid}                           — basic public profile
//  providers/{uid}                       — extended provider profile
//  serviceRequests/{requestId}           — job requests between seeker & provider
//  reviews/{reviewId}                    — post-completion ratings
//  favorites/{uid}/providers/{providerId}— seeker bookmarks
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Reusable helper functions ─────────────────────────────────────────────

    /// True when the caller is authenticated.
    function isAuthenticated() {
      return request.auth != null;
    }

    /// True when the authenticated user's uid equals [uid].
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ── users/{uid} ───────────────────────────────────────────────────────────
    //
    // • Any authenticated user can READ any user doc (needed to display
    //   provider name, photo, and rating on listing / detail screens).
    // • Only the owning user can CREATE or UPDATE their own document.
    // • DELETE is intentionally left closed (handled server-side if needed).
    match /users/{uid} {
      allow read:   if isAuthenticated();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
    }

    // ── providers/{uid} ──────────────────────────────────────────────────────
    //
    // • Any authenticated user can READ provider docs (browse providers,
    //   view profile, rating, availability).
    // • The provider themselves can CREATE or UPDATE all their own fields.
    // • Authenticated seekers can UPDATE rating / ratingCount / updatedAt when
    //   submitting reviews.
    match /providers/{uid} {
      allow read:   if isAuthenticated();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
                    || (isAuthenticated()
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['rating', 'ratingCount', 'updatedAt']));
    }

    // ── serviceRequests/{requestId} ──────────────────────────────────────────
    //
    // • CREATE: authenticated user only if they set seekerId == their own uid.
    //   This prevents a user from submitting a request on behalf of someone else.
    //
    // • READ / UPDATE: only the seeker or the provider named on the document.
    //   This keeps request details private between the two parties.
    //
    // • DELETE: closed — cancellation is done by setting status = "cancelled".
    match /serviceRequests/{requestId} {
      allow create: if isAuthenticated()
                    && request.resource.data.seekerId == request.auth.uid;

      allow read:   if isAuthenticated()
                    && (resource.data.seekerId   == request.auth.uid
                     || resource.data.providerId == request.auth.uid);

      allow update: if isAuthenticated()
                    && (resource.data.seekerId   == request.auth.uid
                     || resource.data.providerId == request.auth.uid);
    }

    // ── reviews/{reviewId} ───────────────────────────────────────────────────
    //
    // • READ: any authenticated user (ratings are public context for a provider).
    //
    // • CREATE: only if the caller is the seeker identified in the new document
    //   (request.resource.data.seekerId == caller's uid).
    //   Note: a stronger check would cross-read the linked serviceRequest to
    //   confirm completed status; that requires a Cloud Function or a backend
    //   write, which is the recommended pattern for production.  The rule below
    //   is the correct client-side approximation.
    //
    // • UPDATE / DELETE: closed — reviews are immutable once created.
    match /reviews/{reviewId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.seekerId == request.auth.uid;
    }

    // ── favorites/{uid}/providers/{providerId} ───────────────────────────────
    //
    // • Only the seeker who owns the favorites collection can read or write
    //   their own bookmarks.  Provider uids are not sensitive, but there is no
    //   reason a third party should access another user's bookmarks.
    match /favorites/{uid}/providers/{providerId} {
      allow read, write: if isOwner(uid);
    }
  }
}